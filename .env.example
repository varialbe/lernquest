# --- Allgemein ---
NODE_ENV=production
TZ=Europe/Berlin
# Absoluter Pfad zur SQLite-DB (API + Pipeline teilen sie)
DATABASE_PATH=/home/varialbe/lernquest/data/lernquest.db

# --- API ---
API_HOST=127.0.0.1
API_PORT=3460
# Öffentliche Web-Origin (CORS) – zusätzlich ist capacitor://localhost erlaubt
WEB_ORIGIN=https://lern.varialbe.xyz
# Token für interne Aufrufe (n8n -> API Notifications)
INTERNAL_TOKEN=change-me
# Web Push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@varialbe.xyz
# Uhrzeit (Berlin) für Streak-Erinnerung
REMINDER_HOUR=19

# --- Pipeline ---
STUDIUM_REPO=/home/varialbe/studium
STUDIUM_DIRS=DS/01_Vorlesungen,EIP/01_Vorlesungen,ERA/01_Vorlesungen
LERNQUEST_REPO=/home/varialbe/lernquest
REGENERATE_ON_MODIFY=false
# Praxis-Level (Transfer- und Schätzfragen) zu jeder neuen Unit erzeugen
GENERATE_BONUS=true
GIT_PUSH=true
CODEX_BIN=codex
CODEX_MODEL=gpt-5.6-luna
CODEX_EFFORT=xhigh
CODEX_REVIEW_EFFORT=high
CODEX_TIMEOUT_MIN=30
PIPELINE_HOST=127.0.0.1
PIPELINE_PORT=3461
PIPELINE_TOKEN=change-me

# --- Benachrichtigung: Telegram (nur Senden) ---
# Leer = Zusammenfassungen landen nur als Admin-Notification in der App.
# Chat-ID einrichten: dem Bot /start schreiben, dann `pnpm pipeline telegram-setup`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
