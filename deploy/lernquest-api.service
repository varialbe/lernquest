[Unit]
Description=LernQuest API (Fastify, 127.0.0.1:3460)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=varialbe
Group=varialbe
WorkingDirectory=/home/varialbe/lernquest/apps/api
EnvironmentFile=/home/varialbe/lernquest/.env
ExecStart=/usr/bin/node --import tsx src/server.ts
Restart=on-failure
RestartSec=3
MemoryHigh=250M
MemoryMax=600M
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
