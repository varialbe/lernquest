[Unit]
Description=LernQuest: Telegram-Warnung bei fehlgeschlagenem Backup

[Service]
Type=oneshot
User=varialbe
EnvironmentFile=/home/varialbe/lernquest/.env
ExecStart=/home/varialbe/lernquest/deploy/notify-telegram.sh "❌ LernQuest-Backup fehlgeschlagen – Details: journalctl -u lernquest-backup -n 50"
