[Unit]
Description=LernQuest Watchdog: Warnung, falls kein nächtlicher Pipeline-Lauf stattfand

[Service]
Type=oneshot
User=varialbe
Group=varialbe
WorkingDirectory=/home/varialbe/lernquest/pipeline
EnvironmentFile=/home/varialbe/lernquest/.env
ExecStart=/usr/bin/node --import tsx src/cli.ts watchdog
SuccessExitStatus=2
