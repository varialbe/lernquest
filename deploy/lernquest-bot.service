[Unit]
Description=LernQuest Telegram-Bot (Newsletter, Long-Polling)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=varialbe
Group=varialbe
WorkingDirectory=/home/varialbe/lernquest/apps/api
EnvironmentFile=/home/varialbe/lernquest/.env
ExecStart=/usr/bin/node --import tsx src/bot.ts
Restart=always
RestartSec=5
MemoryHigh=150M
MemoryMax=300M
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
