{
  "name": "lernquest",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "pipeline": "pnpm --filter @lernquest/pipeline exec tsx src/cli.ts",
    "dev:api": "pnpm --filter @lernquest/api dev",
    "dev:web": "pnpm --filter @lernquest/web dev",
    "build": "pnpm --filter @lernquest/web build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "seed": "pnpm --filter @lernquest/api exec tsx src/seed.ts",
    "db:generate": "pnpm --filter @lernquest/api exec drizzle-kit generate"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild", "sharp", "@node-rs/argon2"]
  }
}
