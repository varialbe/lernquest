{
  "type": "object",
  "additionalProperties": false,
  "required": ["links", "aliases"],
  "properties": {
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "requires"],
        "properties": {
          "id": { "type": "string" },
          "requires": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "type", "why"],
              "properties": {
                "id": { "type": "string" },
                "type": { "type": "string", "enum": ["essential", "background", "related"] },
                "why": { "type": "string", "maxLength": 240 }
              }
            }
          }
        }
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "canonicalId", "confirmed"],
        "properties": {
          "id": { "type": "string" },
          "canonicalId": { "type": "string" },
          "confirmed": { "type": "boolean" }
        }
      }
    }
  }
}
