{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "questions",
    "review"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "prompt",
          "options",
          "correct",
          "explanation",
          "source",
          "difficulty",
          "concepts",
          "slider"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "single",
              "multi",
              "truefalse",
              "estimate"
            ]
          },
          "prompt": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "text"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "correct": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "explanation": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "heading"
            ],
            "properties": {
              "file": {
                "type": "string",
                "description": "Repo-Pfad der Quelldatei"
              },
              "heading": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "exakte Überschrift aus der Liste der Überschriften"
              }
            }
          },
          "difficulty": {
            "type": "integer"
          },
          "concepts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "slider": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "min",
                  "max",
                  "step",
                  "answer",
                  "tolerance",
                  "unit",
                  "scale"
                ],
                "properties": {
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  },
                  "step": {
                    "type": "number"
                  },
                  "answer": {
                    "type": "number"
                  },
                  "tolerance": {
                    "type": "number"
                  },
                  "unit": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "scale": {
                    "type": "string",
                    "enum": [
                      "linear",
                      "log"
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checked",
        "fixed",
        "removed",
        "notes"
      ],
      "properties": {
        "checked": {
          "type": "integer"
        },
        "fixed": {
          "type": "integer"
        },
        "removed": {
          "type": "integer"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
